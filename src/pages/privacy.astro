---
import Base from '../layouts/Base.astro'
import PortableText from '../components/PortableText.astro'
import {client} from '../lib/sanity'

const page =
  (await client.fetch<{heading?: string; lastUpdated?: string; body?: any[]} | null>(
    `*[_type == "privacyPage"][0]{heading, lastUpdated, body}`,
  )) ?? {}
const updated = page.lastUpdated
  ? new Date(page.lastUpdated + 'T12:00:00').toLocaleDateString('en-NZ', {day: 'numeric', month: 'long', year: 'numeric'})
  : undefined
---

<Base
  title="Privacy Policy | CT Studio NZ"
  description="How CT Studio NZ collects, uses and protects the personal information you send through this website."
  path="/privacy"
>
  <main>
    <section class="section">
      <div class="container">
        <div class="legal-page">
          <h1>{page.heading ?? 'Privacy Policy'}</h1>
          {updated && <p><em>Last updated: {updated}</em></p>}
          <PortableText value={page.body} />
        </div>
      </div>
    </section>
  </main>
</Base>
