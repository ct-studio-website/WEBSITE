---
import Base from '../layouts/Base.astro'
import PortableText from '../components/PortableText.astro'
import {client, urlFor} from '../lib/sanity'
import {serviceIcon, equipmentIcons} from '../lib/icons'

type Service = {name: string; intro?: string; items?: string[]; closingLine?: string; priceFrom?: number}
type Equipment = {name: string; description?: string; icon?: string}
type Faq = {question: string; answer: string}
type Photo = {alt?: string; crop?: unknown; hotspot?: unknown; asset?: {_id: string; metadata?: {dimensions?: {width: number; height: number}}}}
type About = {
  heading?: string
  description?: any[]
  servicesHeading?: string
  services?: Service[]
  equipmentHeading?: string
  equipmentIntro?: string
  equipment?: Equipment[]
  equipmentClosing?: string
  images?: Photo[]
  faqHeading?: string
  faq?: Faq[]
  seo?: {title?: string; description?: string}
}

const page: About =
  (await client.fetch(
    `*[_type == "aboutPage"][0]{heading, description, servicesHeading, services, equipmentHeading, equipmentIntro,
      equipment, equipmentClosing, faqHeading, faq, seo,
      images[]{alt, crop, hotspot, asset->{_id, metadata{dimensions{width, height}}}}}`,
  )) ?? {}

const services = (page.services ?? []).filter((s) => s?.name)
const equipment = (page.equipment ?? []).filter((e) => e?.name)
const images = (page.images ?? []).filter((p) => p?.asset?._id)
const faq = (page.faq ?? []).filter((f) => f?.question && f?.answer)
const size = (p: Photo, w: number) => {
  const d = p.asset?.metadata?.dimensions
  return d ? {width: w, height: Math.round((w * d.height) / d.width)} : {}
}

// The FAQ as structured data, so Google and AI tools can quote the answers
const jsonLd = faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({'@type': 'Question', name: f.question, acceptedAnswer: {'@type': 'Answer', text: f.answer}})),
    }
  : undefined
---

<Base
  title={page.seo?.title ?? 'About | CT Studio NZ'}
  description={page.seo?.description ??
    'About CT Studio NZ - Professional photography and videography services, equipment, and frequently asked questions.'}
  path="/about"
  active="about"
  jsonLd={jsonLd}
>
  <main>
    <section class="section section--alt">
      <div class="container">
        <div class="welcome-section text-center">
          <h1 class="fade-in">{page.heading ?? 'Welcome to CT Studio NZ'}</h1>
          <div class="divider"></div>
          <div class="fade-in"><PortableText value={page.description} /></div>
        </div>
      </div>
    </section>

    {services.length > 0 && (
      <section class="section">
        <div class="container">
          <h2 class="text-center fade-in">{page.servicesHeading ?? 'Our Services'}</h2>
          <div class="divider"></div>
          <div class="services-grid">
            {services.map((s, i) => (
              <div class="service-card fade-in">
                <div class="service-card__icon" set:html={serviceIcon(s.name, i)} />
                <h3>{s.name}</h3>
                {s.intro && <p class="service-card__lead">{s.intro}</p>}
                {(s.items?.length ?? 0) > 0 && <ul class="service-card__list">{s.items!.map((item) => <li>{item}</li>)}</ul>}
                {s.priceFrom && <p class="service-card__lead">From ${s.priceFrom.toLocaleString('en-NZ')}</p>}
                {s.closingLine && <p class="service-card__footer">{s.closingLine}</p>}
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {(equipment.length > 0 || images.length > 0) && (
      <section class="section section--alt">
        {equipment.length > 0 && (
          <div class="container text-center">
            <h2 class="fade-in">{page.equipmentHeading ?? 'Our Equipment'}</h2>
            <div class="divider"></div>
            {page.equipmentIntro && <p class="page-header__subtitle fade-in">{page.equipmentIntro}</p>}
            <div class="equipment-grid fade-in">
              {equipment.map((e) => (
                <div class="equipment-item">
                  <Fragment set:html={equipmentIcons[e.icon ?? 'other'] ?? equipmentIcons.other} />
                  <span>{e.name}</span>
                  {e.description && <small>{e.description}</small>}
                </div>
              ))}
            </div>
            {page.equipmentClosing && <p class="equipment-footer fade-in">{page.equipmentClosing}</p>}
          </div>
        )}

        {images.length > 0 && (
          <>
            <br />
            <div class="photo-studio fade-in">
              {images.map((p) => (
                <div class="photo-gridstudio__item">
                  <img
                    src={urlFor(p).width(1200).quality(80).url()}
                    srcset={[600, 900, 1200, 1800].map((w) => `${urlFor(p).width(w).quality(80).url()} ${w}w`).join(', ')}
                    sizes="(max-width: 1200px) 100vw, 1200px"
                    alt={p.alt ?? 'CT Studio NZ'}
                    loading="lazy"
                    {...size(p, 1200)}
                  />
                </div>
              ))}
            </div>
          </>
        )}
      </section>
    )}

    {faq.length > 0 && (
      <section class="section">
        <div class="container">
          <h2 class="text-center fade-in">{page.faqHeading ?? 'Frequently Asked Questions'}</h2>
          <div class="divider"></div>
          <div class="faq-list fade-in">
            {faq.map((f) => (
              <div class="faq-item">
                <div class="faq-question" role="button" tabindex="0" aria-expanded="false">
                  <h4>{f.question}</h4>
                  <div class="faq-toggle" aria-hidden="true"></div>
                </div>
                <div class="faq-answer"><p>{f.answer}</p></div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>
</Base>
