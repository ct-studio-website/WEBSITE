---
import Base from '../layouts/Base.astro'
import {client, urlFor, getSettings} from '../lib/sanity'
import {videoSrc} from '../lib/video'
import Promotions from '../components/Promotions.astro'

type Photo = {alt?: string; crop?: unknown; hotspot?: unknown; asset?: {_id: string; metadata?: {dimensions?: {width: number; height: number}}}}
type Home = {
  tagline?: string
  secondLine?: {text?: string; link?: string}
  heroVideoUrl?: string
  heroPoster?: Photo
  carousel?: Photo[]
  seo?: {title?: string; description?: string}
}

const home: Home =
  (await client.fetch(
    `*[_type == "homePage"][0]{tagline, secondLine, heroVideoUrl, seo,
      heroPoster{alt, crop, hotspot, asset->{_id}},
      carousel[]{alt, crop, hotspot, asset->{_id, metadata{dimensions{width, height}}}}}`,
  )) ?? {}
const settings = await getSettings()

const tagline = home.tagline ?? 'Photographer & Videographer · Christchurch & Canterbury'
const poster = home.heroPoster?.asset ? urlFor(home.heroPoster).width(1280).quality(75).url() : undefined
const carousel = (home.carousel ?? []).filter((p) => p?.asset?._id)

// The carousel strip is 200px tall (150px on phones): ask for 400px for sharp screens
const slide = (p: Photo) => urlFor(p).height(400).quality(80).url()
const slideWidth = (p: Photo) => {
  const d = p.asset?.metadata?.dimensions
  return d ? Math.round((200 * d.width) / d.height) : undefined
}

// Business details for Google and AI search, from Site settings
const name = settings.businessName ?? 'CT Studio NZ'
const phoneIntl = settings.phone ? '+64 ' + settings.phone.replace(/^0/, '') : undefined
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': 'https://ctstudionz.com/#business',
  name,
  url: 'https://ctstudionz.com/',
  logo: settings.logo ? urlFor(settings.logo).width(600).url() : 'https://ctstudionz.com/assets/logo/logo.PNG',
  image: 'https://ctstudionz.com/IMG_4154.jpg',
  description: `Photography and videography studio in ${settings.studioTown ?? 'Rolleston'}, with photoshoots across ${(settings.areasServed ?? ['Christchurch', 'Canterbury']).join(' and ')}, New Zealand.`,
  email: settings.email,
  telephone: phoneIntl,
  areaServed: (settings.areasServed ?? []).map((area) => ({'@type': 'Place', name: area})),
  address: {'@type': 'PostalAddress', addressLocality: settings.studioTown ?? 'Rolleston', addressRegion: 'Canterbury', addressCountry: 'NZ'},
  hasMap: settings.googleProfileUrl,
  serviceType: ['Photography', 'Videography', 'Social media content'],
  sameAs: (settings.socialLinks ?? []).map((l) => l.url),
}
---

<Base
  title={home.seo?.title ?? 'CT Studio NZ | Photography & Videography'}
  description={home.seo?.description ??
    'CT Studio NZ - Professional Photography and Videography in Christchurch, New Zealand. Capturing moments, stories, and brands with elegance and creativity.'}
  path="/"
  active="home"
  jsonLd={jsonLd}
>
  <main>
    <section class="hero">
      {home.heroVideoUrl && (
        <div class="hero__video fade-in">
          <video autoplay muted loop playsinline poster={poster}>
            <source src={videoSrc(home.heroVideoUrl)} type="video/mp4" />
            Your browser does not support the video tag.
          </video>
        </div>
      )}

      <h1 class="hero__tagline fade-in">{tagline}</h1>
      {home.secondLine?.text && (
        <p class="hero__subline fade-in">
          {home.secondLine.link ? <a href={home.secondLine.link}>{home.secondLine.text}</a> : home.secondLine.text}
        </p>
      )}
    </section>

    <Promotions place="card" page="home" />

    {carousel.length > 0 && (
      <section class="carousel-strip">
        <div class="carousel-strip__track">
          {carousel.map((p) => (
            <img class="carousel-strip__image" src={slide(p)} alt={p.alt ?? 'Portfolio image'} loading="lazy" width={slideWidth(p)} height="200" />
          ))}
          {/* Second copy for the seamless loop, hidden from screen readers */}
          {carousel.map((p) => (
            <img class="carousel-strip__image" src={slide(p)} alt="" aria-hidden="true" loading="lazy" width={slideWidth(p)} height="200" />
          ))}
        </div>
      </section>
    )}
  </main>
</Base>
