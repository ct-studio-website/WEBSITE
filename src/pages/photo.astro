---
import Base from '../layouts/Base.astro'
---

<Base
  title="Photography | CT Studio NZ"
  description="CT Studio NZ Photography Portfolio - Family portraits, events, studio photography, and business branding in Christchurch, New Zealand."
  path="/photo"
  active="photo"
  ogTitle="Photography Portfolio | CT Studio NZ"
  ogDescription="Family portraits, events, studio photography, and business branding by CT Studio NZ in Christchurch, New Zealand."
  twitterDescription="Explore CT Studio NZ photography for portraits, events, studio work, and business branding."
>
  <main>
      <!-- Page Header -->
      <section class="page-header">
        <div class="container">
          <h1 class="fade-in">Photography</h1>
          <div class="divider"></div>
          <p class="page-header__subtitle fade-in">
            Explore our curated photography portfolio featuring family
            portraits, couple and maternity shoots, events and celebrations,
            personal branding portraits, studio photography, and lifestyle
            photography. Every image is crafted to preserve genuine emotion and
            beautiful detail.
          </p>
        </div>
      </section>

      <!-- Photo Gallery -->
      <section class="section photo-section">
        <div class="container">
          <div class="filter-buttons fade-in">
            <button class="filter-btn active" data-filter="all">All</button>
            <button class="filter-btn" data-filter="studio">Studio</button>
            <button class="filter-btn" data-filter="outdoor">Outdoor</button>
            <button class="filter-btn" data-filter="events">Events</button>
            <button class="filter-btn" data-filter="business">Business</button>
          </div>

          <div class="photo-grid">
            <!-- Studio Photos -->
            <div class="photo-grid__item" data-category="studio">
              <img
                src="https://res.cloudinary.com/dibcmlyg0/image/upload/w_600,f_auto,q_auto/v1781405224/DSC01118_tuphrq.jpg"
