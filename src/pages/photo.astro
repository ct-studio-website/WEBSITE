---
import Base from '../layouts/Base.astro'
import {client, urlFor} from '../lib/sanity'
import {slugify} from '../lib/video'

type Photo = {
  alt?: string
  caption?: string
  asset?: {_id: string; metadata?: {dimensions?: {width: number; height: number}; palette?: {dominant?: {background?: string}}}}
  crop?: unknown
  hotspot?: unknown
}
type Category = {name: string; photos?: Photo[]}
type Page = {heading?: string; subtitle?: string; categories?: Category[]; seo?: {title?: string; description?: string}}

const page: Page =
  (await client.fetch(
    `*[_type == "photoPage"][0]{heading, subtitle, seo,
      categories[]{name, photos[]{alt, caption, crop, hotspot,
        asset->{_id, metadata{dimensions{width, height}, palette{dominant{background}}}}}}}`,
  )) ?? {}

// Only categories that have photos get a filter button
const categories = (page.categories ?? [])
  .map((c) => ({...c, key: slugify(c.name ?? ''), photos: (c.photos ?? []).filter((p) => p?.asset?._id)}))
  .filter((c) => c.name && c.photos.length > 0)

// Each photo is served at the size the screen needs: 1 column on phones, 2 on tablets, 3 on desktop
const widths = [400, 600, 900, 1200]
const sizes = '(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw'
const src = (p: Photo, w: number) => urlFor(p).width(w).quality(80).url()
const srcset = (p: Photo) => widths.map((w) => `${src(p, w)} ${w}w`).join(', ')
const ratio = (p: Photo) => {
  const d = p.asset?.metadata?.dimensions
  return d ? {width: 600, height: Math.round((600 * d.height) / d.width)} : {}
}
---

<Base
  title={page.seo?.title ?? 'Photography | CT Studio NZ'}
  description={page.seo?.description ??
    'CT Studio NZ Photography Portfolio - Family portraits, events, studio photography, and business branding in Christchurch, New Zealand.'}
  path="/photo"
  active="photo"
>
  <main>
    <section class="page-header">
      <div class="container">
        <h1 class="fade-in">{page.heading ?? 'Photography'}</h1>
        <div class="divider"></div>
        {page.subtitle && <p class="page-header__subtitle fade-in">{page.subtitle}</p>}
      </div>
    </section>

    <section class="section photo-section">
      <div class="container">
        {categories.length > 1 && (
          <div class="filter-buttons fade-in">
            <button class="filter-btn active" data-filter="all">All</button>
            {categories.map((c) => <button class="filter-btn" data-filter={c.key}>{c.name}</button>)}
          </div>
        )}

        <div class="photo-grid">
          {categories.flatMap((c) =>
            c.photos.map((p) => (
              <div
                class="photo-grid__item"
                data-category={c.key}
                style={p.asset?.metadata?.palette?.dominant?.background
                  ? `background-color: ${p.asset.metadata.palette.dominant.background}`
                  : undefined}
              >
                <img
                  src={src(p, 600)}
                  srcset={srcset(p)}
                  sizes={sizes}
                  data-full={src(p, 1920)}
                  alt={p.alt ?? `${c.name} photography`}
                  loading="lazy"
                  decoding="async"
                  {...ratio(p)}
                />
              </div>
            )),
          )}
        </div>
      </div>
    </section>
  </main>

  <Fragment slot="overlays">
    <div id="lightbox" class="lightbox">
      <button class="lightbox__close" aria-label="Close lightbox">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <img class="lightbox__image" src="" alt="" />
    </div>
  </Fragment>
</Base>
