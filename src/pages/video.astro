---
import Base from '../layouts/Base.astro'
import {client, urlFor} from '../lib/sanity'
import {videoSrc, videoFrame, uploadDate, slugify} from '../lib/video'

type Video = {title: string; url: string; thumbnail?: any}
type Category = {name: string; videos?: Video[]}
type Page = {heading?: string; subtitle?: string; categories?: Category[]; seo?: {title?: string; description?: string}}

const page: Page =
  (await client.fetch(`*[_type == "videoPage"][0]{heading, subtitle, categories[]{name, videos[]{title, url, thumbnail}}, seo}`)) ?? {}

// Only categories that have videos get a filter button
const categories = (page.categories ?? [])
  .map((c) => ({...c, key: slugify(c.name ?? ''), videos: (c.videos ?? []).filter((v) => v?.url)}))
  .filter((c) => c.name && c.videos.length > 0)

const thumb = (v: Video) =>
  v.thumbnail ? urlFor(v.thumbnail).width(800).height(450).fit('crop').url() : videoFrame(v.url, 800, 450)

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': categories.flatMap((c) =>
    c.videos
      .filter((v) => thumb(v) && uploadDate(v.url))
      .map((v) => ({
        '@type': 'VideoObject',
        name: v.title,
        description: `${v.title}: ${c.name.toLowerCase()} video by CT Studio NZ`,
        thumbnailUrl: thumb(v),
        contentUrl: videoSrc(v.url),
        uploadDate: uploadDate(v.url),
      })),
  ),
}
---

<Base
  title={page.seo?.title ?? 'Videography | CT Studio NZ'}
  description={page.seo?.description ??
    'CT Studio NZ Videography Portfolio - Event highlights, promotional videos, social media reels in Christchurch, New Zealand.'}
  path="/video"
  active="video"
  jsonLd={jsonLd['@graph'].length ? jsonLd : undefined}
>
  <main>
    <section class="page-header">
      <div class="container">
        <h1 class="fade-in">{page.heading ?? 'Videography'}</h1>
        <div class="divider"></div>
        {page.subtitle && <p class="page-header__subtitle fade-in">{page.subtitle}</p>}
      </div>
    </section>

    <section class="section video-section">
      <div class="container">
        {categories.length > 1 && (
          <div class="filter-buttons fade-in">
            <button class="filter-btn active" data-filter="all">All</button>
            {categories.map((c) => <button class="filter-btn" data-filter={c.key}>{c.name}</button>)}
          </div>
        )}

        <div class="video-grid fade-in">
          {categories.flatMap((c) =>
            c.videos.map((v) => (
              <div class="video-grid__item" data-category={c.key} data-video={videoSrc(v.url)}>
                <img src={thumb(v)} alt={v.title} loading="lazy" width="800" height="450" />
                <div class="video-grid__play">
                  <svg viewBox="0 0 24 24"><polygon points="5,3 19,12 5,21" /></svg>
                </div>
              </div>
            )),
          )}
        </div>
      </div>
    </section>
  </main>

  <Fragment slot="overlays">
    <div
      class="video-modal"
      id="videoModal"
      role="dialog"
      aria-modal="true"
      aria-label="Video player"
    >
      <button class="video-modal__close" aria-label="Close video">
        <svg
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <div class="video-modal__content" id="videoModalContent"></div>
    </div>
  </Fragment>
</Base>
