---
import Base from '../layouts/Base.astro'
---

<Base
  title="Videography | CT Studio NZ"
  description="CT Studio NZ Videography Portfolio - Event highlights, promotional videos, social media reels in Christchurch, New Zealand."
  path="/video"
  active="video"
  ogTitle="Videography Portfolio | CT Studio NZ"
  ogDescription="Event highlights, promotional videos, and social media reels by CT Studio NZ in Christchurch, New Zealand."
  twitterDescription="Explore CT Studio NZ videography for events, promotions, and social media content."
>
  <main>
      <!-- Page Header -->
      <section class="page-header">
        <div class="container">
          <h1 class="fade-in">Videography</h1>
          <div class="divider"></div>
          <p class="page-header__subtitle fade-in">
            We create engaging visual stories that connect with your audience —
            event highlights, promotional business videos, social media reels,
            testimonials, commercial content, and personal branding videos.
          </p>
        </div>
      </section>

      <!-- Video Gallery -->
      <section class="section video-section">
        <div class="container">
          <div class="filter-buttons fade-in">
            <button class="filter-btn active" data-filter="all">All</button>
            <button class="filter-btn" data-filter="outdoor">Outdoor</button>
            <button class="filter-btn" data-filter="events">Events</button>
            <button class="filter-btn" data-filter="business">Business</button>
          </div>

          <div class="video-grid fade-in">
            <!-- Business Videos -->
            <div
              class="video-grid__item"
              data-category="business"
              data-video="https://res.cloudinary.com/dibcmlyg0/video/upload/v1782727634/Anne_Reel_1_tvnnod.mp4"
            >
              <img
                src="https://res.cloudinary.com/dibcmlyg0/video/upload/v1782727634/Anne_Reel_1_tvnnod.jpg"
                alt="Business video"
                loading="lazy"
              />
              <div class="video-grid__play">
                <svg viewBox="0 0 24 24">
                  <polygon points="5,3 19,12 5,21" />
                </svg>
              </div>
            </div>
            <div
              class="video-grid__item"
              data-category="business"
              data-video="https://res.cloudinary.com/dibcmlyg0/video/upload/v1782726313/Arti_Reel_1_hi9lnm.mp4"
            >
              <img
                src="https://res.cloudinary.com/dibcmlyg0/video/upload/v1782726313/Arti_Reel_1_hi9lnm.jpg"
                alt="Business video"
                loading="lazy"
              />
              <div class="video-grid__play">
                <svg viewBox="0 0 24 24">
                  <polygon points="5,3 19,12 5,21" />
                </svg>
              </div>
            </div>
            <div
              class="video-grid__item"
              data-category="business"
              data-video="https://res.cloudinary.com/dibcmlyg0/video/upload/v1782726122/ranjan_Reel_1_xr2ims.mp4"
            >
              <img
                src="https://res.cloudinary.com/dibcmlyg0/video/upload/v1782726122/ranjan_Reel_1_xr2ims.jpg"
                alt="Business video"
                loading="lazy"
              />
              <div class="video-grid__play">
                <svg viewBox="0 0 24 24">
                  <polygon points="5,3 19,12 5,21" />
                </svg>
              </div>
            </div>

            <!-- Events Videos -->
            <div
              class="video-grid__item"
              data-category="events"
              data-video="https://res.cloudinary.com/dibcmlyg0/video/upload/v1782725692/pada_padma_Reel_1_r6ok9a.mp4"
            >
              <img
                src="https://res.cloudinary.com/dibcmlyg0/video/upload/v1782725692/pada_padma_Reel_1_r6ok9a.jpg"
                alt="Events video"
                loading="lazy"
              />
              <div class="video-grid__play">
                <svg viewBox="0 0 24 24">
                  <polygon points="5,3 19,12 5,21" />
                </svg>
              </div>
            </div>
            <div
              class="video-grid__item"
              data-category="events"
              data-video="https://res.cloudinary.com/dibcmlyg0/video/upload/v1782725414/canterlanka_Reel_1_yuewso.mp4"
            >
              <img
                src="https://res.cloudinary.com/dibcmlyg0/video/upload/v1782725414/canterlanka_Reel_1_yuewso.jpg"
                alt="Events video"
                loading="lazy"
              />
              <div class="video-grid__play">
                <svg viewBox="0 0 24 24">
                  <polygon points="5,3 19,12 5,21" />
                </svg>
              </div>
            </div>
            <div
              class="video-grid__item"
              data-category="events"
              data-video="https://res.cloudinary.com/dibcmlyg0/video/upload/v1782723463/Ciara_and_Matt_1_y7gi52.mp4"
            >
              <img
                src="https://res.cloudinary.com/dibcmlyg0/video/upload/v1782723463/Ciara_and_Matt_1_y7gi52.jpg"
                alt="Events video"
                loading="lazy"
              />
              <div class="video-grid__play">
                <svg viewBox="0 0 24 24">
                  <polygon points="5,3 19,12 5,21" />
                </svg>
              </div>
            </div>
            <div
              class="video-grid__item"
              data-category="events"
              data-video="https://res.cloudinary.com/dibcmlyg0/video/upload/v1782613760/WORLD_DRUMMING_FESTIVAL_2026_ek8p1n.mp4"
            >
              <img
                src="https://res.cloudinary.com/dibcmlyg0/video/upload/v1782613760/WORLD_DRUMMING_FESTIVAL_2026_ek8p1n.jpg"
                alt="Events video"
                loading="lazy"
              />
              <div class="video-grid__play">
                <svg viewBox="0 0 24 24">
                  <polygon points="5,3 19,12 5,21" />
                </svg>
              </div>
            </div>

            <!-- Outdoor Videos -->
            <div
              class="video-grid__item"
              data-category="outdoor"
              data-video="https://res.cloudinary.com/dibcmlyg0/video/upload/v1782724730/indiana_Reel_1_u1t2g2.mp4"
            >
              <img
                src="https://res.cloudinary.com/dibcmlyg0/video/upload/v1782724730/indiana_Reel_1_u1t2g2.jpg"
                alt="Outdoor video"
                loading="lazy"
              />
              <div class="video-grid__play">
                <svg viewBox="0 0 24 24">
                  <polygon points="5,3 19,12 5,21" />
                </svg>
              </div>
            </div>
            <div
              class="video-grid__item"
              data-category="outdoor"
              data-video="https://res.cloudinary.com/dibcmlyg0/video/upload/v1782724289/Anne_Reel_y28nvx.mp4"
            >
              <img
                src="https://res.cloudinary.com/dibcmlyg0/video/upload/v1782724289/Anne_Reel_y28nvx.jpg"
                alt="Outdoor video"
                loading="lazy"
              />
              <div class="video-grid__play">
                <svg viewBox="0 0 24 24">
                  <polygon points="5,3 19,12 5,21" />
                </svg>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

  <Fragment slot="overlays">
    <div
      class="video-modal"
      id="videoModal"
      role="dialog"
      aria-modal="true"
      aria-label="Video player"
    >
      <button class="video-modal__close" aria-label="Close video">
        <svg
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <div class="video-modal__content" id="videoModalContent"></div>
    </div>
  </Fragment>
</Base>
