---
import Base from '../layouts/Base.astro'
import SocialIcons from '../components/SocialIcons.astro'
import {getSettings, telHref, joinAreas} from '../lib/sanity'

const settings = await getSettings()
---

<Base
  title="Contact | CT Studio NZ"
  description="Contact CT Studio NZ - Get in touch for professional photography and videography services in Christchurch, New Zealand."
  path="/contact"
  active="contact"
  ogTitle="Contact CT Studio NZ | Photography & Videography"
  ogDescription="Get in touch with CT Studio NZ for photography and videography services in Christchurch, New Zealand."
  twitterDescription="Contact CT Studio NZ to discuss your next photography or videography project."
>
  <main>
      <!-- Contact Section -->
      <section class="section section--alt">
        <div class="container">
          <h1 class="text-center fade-in">Get in Touch</h1>
          <div class="divider"></div>
          <div class="contact-grid">
            <form
              class="contact-form fade-in"
              action="https://formspree.io/f/xlgqrplq"
              method="POST"
              id="contactForm"
            >
              <div class="form-group">
                <label for="name">Name *</label>
                <input type="text" id="name" name="name" required />
              </div>
              <div class="form-group">
                <label for="email">Email *</label>
                <input type="email" id="email" name="email" required />
              </div>
              <div class="form-group">
                <label for="phone">Phone</label>
                <input type="tel" id="phone" name="phone" />
              </div>
              <div class="form-group">
                <label for="service">Service interested in</label>
                <select id="service" name="service">
                  <option value="">Select a service</option>
                  <option value="photography">Photography</option>
                  <option value="videography">Videography</option>
                  <option value="both">Both</option>
                  <option value="other">Other</option>
                </select>
              </div>
              <div class="form-group">
                <label for="message">Message *</label>
                <textarea id="message" name="message" required></textarea>
              </div>
              <button type="submit" class="submit-btn">Send Message</button>
            </form>

            <div class="contact-info fade-in">
              <h3>Contact Information</h3>
              <p>Studio in {settings.studioTown} · Photoshoots across {joinAreas(settings.areasServed)}</p>
              {settings.phone && <p>Phone: <a href={telHref(settings.phone)}>{settings.phone}</a></p>}
              {settings.email && <p>Email: <a href={`mailto:${settings.email}`}>{settings.email}</a></p>}
              <div class="contact-info__social">
                <SocialIcons links={settings.socialLinks} />
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

  <Fragment slot="overlays">
    <div class="toast" id="toast">Thank you! We'll be in touch soon.</div>
  </Fragment>
</Base>
