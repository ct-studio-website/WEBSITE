---
import Base from '../layouts/Base.astro'
---

<Base
  title="Contact | CT Studio NZ"
  description="Contact CT Studio NZ - Get in touch for professional photography and videography services in Christchurch, New Zealand."
  path="/contact"
  active="contact"
  ogTitle="Contact CT Studio NZ | Photography & Videography"
  ogDescription="Get in touch with CT Studio NZ for photography and videography services in Christchurch, New Zealand."
  twitterDescription="Contact CT Studio NZ to discuss your next photography or videography project."
>
  <main>
      <!-- Contact Section -->
      <section class="section section--alt">
        <div class="container">
          <h1 class="text-center fade-in">Get in Touch</h1>
          <div class="divider"></div>
          <div class="contact-grid">
            <form
              class="contact-form fade-in"
              action="https://formspree.io/f/xlgqrplq"
              method="POST"
              id="contactForm"
            >
              <div class="form-group">
                <label for="name">Name *</label>
                <input type="text" id="name" name="name" required />
              </div>
              <div class="form-group">
                <label for="email">Email *</label>
                <input type="email" id="email" name="email" required />
              </div>
              <div class="form-group">
                <label for="phone">Phone</label>
                <input type="tel" id="phone" name="phone" />
              </div>
              <div class="form-group">
                <label for="service">Service interested in</label>
                <select id="service" name="service">
                  <option value="">Select a service</option>
                  <option value="photography">Photography</option>
                  <option value="videography">Videography</option>
                  <option value="both">Both</option>
                  <option value="other">Other</option>
                </select>
              </div>
              <div class="form-group">
                <label for="message">Message *</label>
                <textarea id="message" name="message" required></textarea>
              </div>
              <button type="submit" class="submit-btn">Send Message</button>
            </form>

            <div class="contact-info fade-in">
              <h3>Contact Information</h3>
              <p>Studio in Rolleston · Photoshoots across Christchurch and Canterbury</p>
              <p>Phone: <a href="tel:+64224663080">022 466 3080</a></p>
              <p>
                Email:
                <a href="mailto:ctstudionz89@gmail.com"
                  >ctstudionz89@gmail.com</a
                >
              </p>
              <div class="contact-info__social">
                <a
                  href="https://www.instagram.com/ct_studio_nz?fbclid=IwY2xjawR-abRleHRuA2FlbQIxMABicmlkETFkNm5seWZEQk8ybkp4Zkp6c3J0YwZhcHBfaWQQMjIyMDM5MTc4ODIwMDg5MgABHsn1xfxllaK53a_IwjA69Fi3jUbWtIgZSVNzldQD9gm7qn69rchC-dgLiTzD_aem_eN1hvQk64l7Ii-B9XojUvA"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Instagram"
                >
                  <svg viewBox="0 0 24 24">
                    <path
                      d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
                    />
                  </svg>
                </a>
                <a
                  href="https://www.youtube.com/@ctstudionz"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="YouTube"
                >
                  <svg viewBox="0 0 24 24">
                    <path
                      d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
                    />
                  </svg>
                </a>
                <a
                  href="https://www.facebook.com/ctstudionz"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Facebook"
                >
                  <svg viewBox="0 0 24 24">
                    <path
                      d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                    />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

  <Fragment slot="overlays">
    <div class="toast" id="toast">Thank you! We'll be in touch soon.</div>
  </Fragment>
</Base>
