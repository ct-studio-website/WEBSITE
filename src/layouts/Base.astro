---
import {getSettings, urlFor} from '../lib/sanity'
import SocialIcons from '../components/SocialIcons.astro'

// Shared page shell: head, header, menu, footer, booking panel, WhatsApp button.
interface Props {
  title: string
  description: string
  path: string
  active?: 'home' | 'photo' | 'video' | 'social' | 'about' | 'contact'
  ogTitle?: string
  ogDescription?: string
  twitterDescription?: string
  ogImage?: string
  ogImageAlt?: string
  jsonLd?: Record<string, unknown>
}
const {
  title,
  description,
  path,
  active,
  ogTitle = title,
  ogDescription = description,
  twitterDescription = ogDescription,
  ogImage = 'https://ctstudionz.com/IMG_4154.jpg',
  ogImageAlt = 'CT Studio NZ photography studio',
  jsonLd,
} = Astro.props
const canonical = new URL(path, 'https://ctstudionz.com').href

const settings = await getSettings()
const businessName = settings.businessName ?? 'CT Studio NZ'
const logoUrl = settings.logo
  ? urlFor(settings.logo).width(600).url()
  : 'https://res.cloudinary.com/dibcmlyg0/image/upload/q_auto/f_auto/v1779698741/logo_yxofkd.png'
const whatsapp = settings.whatsappNumber ?? '64224663080'
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <meta name="author" content="CT Studio NZ" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#111111" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/assets/logo/logo.PNG" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CT Studio NZ" />
    <meta property="og:locale" content="en_NZ" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={twitterDescription} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600&family=DM+Sans:wght@400;500&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600&family=DM+Sans:wght@400;500&display=swap" /></noscript>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <header class="header">
      <div class="header__row-1">
        <div class="container">
          <div class="header__social">
            <SocialIcons links={settings.socialLinks} />
          </div>
          <button
            class="header__hamburger"
            aria-label="Toggle menu"
            aria-expanded="false"
          >
            <span></span>
            <span></span>
            <span></span>
          </button>
        </div>
      </div>
      <div class="header__row-2">
        <div class="container">
          <a href="/" class="header__logo">
            <img
              src={logoUrl}
              alt={`${businessName} logo`}
            />
          </a>
          <nav class="header__nav" aria-label="Main navigation">
            <a href="/" class={active === "home" ? "active" : undefined}>Home</a>
            <a href="/photo" class={active === "photo" ? "active" : undefined}>Photo</a>
            <a href="/video" class={active === "video" ? "active" : undefined}>Video</a>
            <a href="/social-media-content" class={active === "social" ? "active" : undefined}>Social Media</a>
            <a href="/about" class={active === "about" ? "active" : undefined}>About</a>
            <a href="/contact" class={active === "contact" ? "active" : undefined}>Contact</a>
          </nav>
        </div>
      </div>
    </header>
    <div
      class="mobile-menu"
      role="dialog"
      aria-modal="true"
      aria-label="Mobile navigation"
    >
      <a href="/" class={active === "home" ? "active" : undefined}>Home</a>
      <a href="/photo" class={active === "photo" ? "active" : undefined}>Photo</a>
      <a href="/video" class={active === "video" ? "active" : undefined}>Video</a>
            <a href="/social-media-content" class={active === "social" ? "active" : undefined}>Social Media</a>
      <a href="/about" class={active === "about" ? "active" : undefined}>About</a>
      <a href="/contact" class={active === "contact" ? "active" : undefined}>Contact</a>
    </div>

    <slot />

    <slot name="overlays" />

    <footer class="footer">
      <div class="container">
        <div class="footer__logo">
          <img
            src={logoUrl}
            alt={`${businessName} logo`}
            style="max-height: 60px; width: auto"
          />
        </div>
        <p class="footer__copyright">
          &copy; {new Date().getFullYear()} {businessName}. All rights reserved.
        </p>
        <div class="footer__social">
            <SocialIcons links={settings.socialLinks} />
        </div>
        <div class="footer__links">
          <a href="/privacy">Privacy Policy</a>
        </div>
        <div class="footer__credit-wrap">
          <a class="footer__credit sdA-hover" href="https://shedecodes.dev" target="_blank" rel="noopener">
            <svg viewBox="0 36 260 100" height="20" width="52" aria-hidden="true" focusable="false"><path d="M42 50L12 86L42 122M190 122L204 50M220 50L248 86L220 122" fill="none" stroke="#8A4DFF" stroke-width="12" stroke-linecap="round" stroke-linejoin="round"/><g transform="matrix(.6 0 0 .6 58 23.6)"><g fill="#FF2E93"><rect class="sdA-b2" style="animation-delay:0.11s" x="12" y="96" width="18" height="18" rx="2"/><rect class="sdA-b2" style="animation-delay:1.02s" x="34" y="52" width="18" height="18" rx="2"/><rect class="sdA-b2" style="animation-delay:0.22s" x="34" y="96" width="18" height="18" rx="2"/><rect class="sdA-b2" style="animation-delay:4.33s" x="56" y="30" width="18" height="18" rx="2"/><rect class="sdA-b" style="animation-delay:1.13s" x="56" y="52" width="18" height="18" rx="2"/><rect class="sdA-b2" style="animation-delay:2.73s" x="56" y="74" width="18" height="18" rx="2"/><rect class="sdA-b2" style="animation-delay:0.33s" x="56" y="96" width="18" height="18" rx="2" fill="#FFD23F"/><rect class="sdA-b2" style="animation-delay:3.53s" x="56" y="118" width="18" height="18" rx="2"/><rect class="sdA-b2" style="animation-delay:4.44s" x="78" y="30" width="18" height="18" rx="2"/><rect class="sdA-b2" style="animation-delay:1.24s" x="78" y="52" width="18" height="18" rx="2"/><rect class="sdA-b" style="animation-delay:2.84s" x="78" y="74" width="18" height="18" rx="2"/><rect class="sdA-b" style="animation-delay:0.44s" x="78" y="96" width="18" height="18" rx="2"/><rect class="sdA-b" style="animation-delay:3.64s" x="78" y="118" width="18" height="18" rx="2"/><rect class="sdA-b" style="animation-delay:2.04s" x="78" y="140" width="18" height="18" rx="2"/><rect class="sdA-b" style="animation-delay:5.24s" x="78" y="162" width="18" height="18" rx="2"/><rect class="sdA-g" style="animation-delay:2.4s" x="-10" y="74" width="18" height="18" rx="2"/><rect class="sdA-g" style="animation-delay:0.0s" x="-10" y="96" width="18" height="18" rx="2"/><rect class="sdA-g" style="animation-delay:3.2s" x="-10" y="118" width="18" height="18" rx="2"/><rect class="sdA-g" style="animation-delay:0.91s" x="12" y="52" width="18" height="18" rx="2"/><rect class="sdA-g2" style="animation-delay:2.51s" x="12" y="74" width="18" height="18" rx="2"/><rect class="sdA-g2" style="animation-delay:3.31s" x="12" y="118" width="18" height="18" rx="2"/><rect class="sdA-g2" style="animation-delay:1.71s" x="12" y="140" width="18" height="18" rx="2"/><rect class="sdA-g2" style="animation-delay:4.22s" x="34" y="30" width="18" height="18" rx="2"/><rect class="sdA-g" style="animation-delay:2.62s" x="34" y="74" width="18" height="18" rx="2"/><rect class="sdA-g" style="animation-delay:3.42s" x="34" y="118" width="18" height="18" rx="2"/><rect class="sdA-g2" style="animation-delay:1.82s" x="34" y="140" width="18" height="18" rx="2"/><rect class="sdA-g" style="animation-delay:1.93s" x="56" y="140" width="18" height="18" rx="2"/><rect class="sdA-g" style="animation-delay:5.13s" x="56" y="162" width="18" height="18" rx="2"/><circle cx="142" cy="52" r="20"/><path d="M98 38H100C130 38 150 50 162 72L182 110L164 120L174 140L148 146C136 166 118 176 100 176H98Z"/></g><path d="M104 50V74M119 52L115 72M162 112L144 120M154 84L138 90M152 136L138 128" fill="none" stroke="#1E1030" stroke-width="8" stroke-linecap="round"/><path d="M108 100Q124 86 140 100Q124 112 108 100Z" fill="#FFD23F"/><circle cx="124" cy="99" r="5" fill="#1E1030"/><path d="M100 124H112L100 138Z" fill="#1E1030"/></g></svg>
            <span>Built by <strong>SheDecodes</strong></span>
          </a>
        </div>
      </div>
    </footer>

    <!-- Sticky Buttons -->
    <!-- Side-tab Book Your Session -->
    <div class="sticky-side-tab" id="bookSideTab">
      <button
        class="sticky-side-tab__btn"
        onclick="openBookingPanel()"
        aria-label="Book Your Session"
      >
        Book Your Session!
      </button>
    </div>

    <!-- Booking Panel Overlay -->
    <div
      class="booking-panel-overlay"
      id="bookingOverlay"
      onclick="closeBookingPanel()"
    ></div>
    <div class="booking-panel" id="bookingPanel">
      <button
        class="booking-panel__close"
        onclick="closeBookingPanel()"
        aria-label="Close"
      >
        &times;
      </button>
      <div id="calendarRoot"></div>
    </div>

    <!-- WhatsApp sticky button -->
    <a
      href={`https://wa.me/${whatsapp}`}
      class="sticky-whatsapp-btn"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="WhatsApp"
    >
      <svg viewBox="0 0 24 24">
        <path
          fill="currentColor"
          d="M12.031 0C5.385 0 0 5.388 0 12.035c0 2.128.552 4.195 1.6 6.02L.036 24l6.108-1.597c1.758.946 3.738 1.445 5.882 1.445 6.645 0 12.032-5.389 12.032-12.035S18.676 0 12.031 0zm-1.01 22.046c-1.782 0-3.528-.479-5.06-1.385l-.36-.214-3.766.985.998-3.67-.235-.373a9.99 9.99 0 0 1-1.528-5.353c0-5.518 4.49-10.01 10.01-10.01 2.673 0 5.183 1.042 7.073 2.934 1.89 1.89 2.932 4.399 2.932 7.076 0 5.519-4.49 10.01-10.01 10.01zm5.496-7.512c-.302-.15-1.787-.882-2.064-.984-.277-.101-.479-.151-.68.151s-.781.984-.957 1.185c-.176.202-.353.227-.655.076a8.17 8.17 0 0 1-2.4-1.482 9.07 9.07 0 0 1-1.658-2.068c-.176-.303-.018-.466.133-.617.136-.136.302-.353.453-.529.151-.176.202-.302.302-.504.101-.201.05-.378-.025-.529-.076-.151-.68-1.637-.932-2.241-.246-.593-.497-.512-.68-.521h-.579c-.202 0-.529.076-.806.378-.277.303-1.058 1.034-1.058 2.52 0 1.486 1.083 2.922 1.234 3.123.151.202 2.13 3.251 5.16 4.56.721.311 1.282.497 1.721.636.723.23 1.382.197 1.899.119.58-.088 1.787-.73 2.039-1.436.252-.705.252-1.31.176-1.436-.075-.126-.277-.201-.579-.352z"
        />
      </svg>
    </a>

    <script is:inline src="/js/main.js"></script>
    <script is:inline src="/js/calendar.js"></script>
  </body>
</html>
